#!/usr/bin/env bash
# Runs from anywhere: resolves the project, then starts the MCP server and the owner dashboard.
# AI apps start tools with a minimal PATH; add the usual places Node lives.
export PATH="/opt/homebrew/bin:/usr/local/bin:$HOME/.volta/bin:$HOME/.local/bin:$PATH"
ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
exec "$ROOT/node_modules/.bin/tsx" "$ROOT/src/main.ts" "$@"
